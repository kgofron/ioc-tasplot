# ioc-tasplot — TAS plot PyDevice records (default prefix TAS:Plot:)
# Template follows ioc-hkl PyDevice pattern: DTYP=pydev, INP/OUT=@graffiti_plot.method()
# Long paths use lsi/lso (EPICS 3.15+); stringin/out are limited to 40 chars.

record(longout, "$(P)Acquire") {
    field(DESC, "Reload current scan file")
    field(DTYP, "pydev")
    field(OUT, "@graffiti_plot.acquire()")
}

record(waveform, "$(P)Xdata") {
    field(DESC, "X axis (XCol)")
    field(DTYP, "pydev")
    field(INP, "@graffiti_plot.xdata()")
    field(NELM, "$(MAXPTS)")
    field(FTVL, "DOUBLE")
    field(SCAN, "1 second")
}

record(waveform, "$(P)Ydata") {
    field(DESC, "Y axis (YCol)")
    field(DTYP, "pydev")
    field(INP, "@graffiti_plot.ydata()")
    field(NELM, "$(MAXPTS)")
    field(FTVL, "DOUBLE")
    field(SCAN, "1 second")
}

record(waveform, "$(P)YdataErr") {
    field(DESC, "Poisson sqrt(Y) errors")
    field(DTYP, "pydev")
    field(INP, "@graffiti_plot.ydata_err()")
    field(NELM, "$(MAXPTS)")
    field(FTVL, "DOUBLE")
    field(SCAN, "1 second")
}

