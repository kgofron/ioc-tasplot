# ioc-tasplot — TAS plot PyDevice records (default prefix TAS:Plot:)
# Template follows ioc-hkl PyDevice pattern: DTYP=pydev, INP/OUT=@graffiti_plot.method()
# Long paths use lsi/lso (EPICS 3.15+); stringin/out are limited to 40 chars.

record(longout, "$(P)Acquire") {
    field(DESC, "Reload current scan file")
    field(DTYP, "pydev")
    field(OUT, "@graffiti_plot.acquire()")
}

record(waveform, "$(P)Xdata") {
    field(DESC, "X axis (def_x or SPEC col 1)")
    field(DTYP, "pydev")
    field(INP, "@graffiti_plot.xdata()")
    field(NELM, "$(MAXPTS)")
    field(FTVL, "DOUBLE")
    field(SCAN, "1 second")
}

record(waveform, "$(P)Ydata") {
    field(DESC, "Scan Y axis (default def_y / Detector)")
    field(DTYP, "pydev")
    field(INP, "@graffiti_plot.ydata()")
    field(NELM, "$(MAXPTS)")
    field(FTVL, "DOUBLE")
    field(SCAN, "1 second")
}

record(waveform, "$(P)YdataErr") {
    field(DESC, "Poisson sqrt(Y) errors")
    field(DTYP, "pydev")
    field(INP, "@graffiti_plot.ydata_err()")
    field(NELM, "$(MAXPTS)")
    field(FTVL, "DOUBLE")
    field(SCAN, "1 second")
}

record(longin, "$(P)NRows_RBV") {
    field(DTYP, "pydev")
    field(INP, "@graffiti_plot.nrows_rbv()")
    field(SCAN, ".5 second")
}

record(longin, "$(P)NColumns_RBV") {
    field(DTYP, "pydev")
    field(INP, "@graffiti_plot.ncolumns_rbv()")
    field(SCAN, ".5 second")
}

record(stringin, "$(P)DetX_RBV") {
    field(DTYP, "pydev")
    field(INP, "@graffiti_plot.det_x_rbv()")
    field(SCAN, ".5 second")
}

record(stringin, "$(P)DetY_RBV") {
    field(DTYP, "pydev")
    field(INP, "@graffiti_plot.det_y_rbv()")
    field(SCAN, ".5 second")
}

record(stringin, "$(P)Format_RBV") {
    field(DTYP, "pydev")
    field(INP, "@graffiti_plot.format_rbv()")
    field(SCAN, ".5 second")
}

record(lsi, "$(P)FullFileName_RBV") {
    field(DTYP, "pydev")
    field(INP, "@graffiti_plot.full_file_name_rbv()")
    field(SIZV, "255")
    field(SCAN, ".5 second")
}

record(bi, "$(P)FileExists_RBV") {
    field(DTYP, "pydev")
    field(INP, "@graffiti_plot.file_exists_rbv()")
    field(ZNAM, "No")
    field(ONAM, "Yes")
    field(SCAN, ".5 second")
}

record(lsi, "$(P)Command_RBV") {
    field(DTYP, "pydev")
    field(INP, "@graffiti_plot.command_rbv()")
    field(SIZV, "255")
    field(SCAN, ".5 second")
}

record(lsi, "$(P)LastError_RBV") {
    field(DTYP, "pydev")
    field(INP, "@graffiti_plot.last_error_rbv()")
    field(SIZV, "255")
    field(SCAN, ".5 second")
}

record(lso, "$(P)SelectedFile") {
    field(DESC, "Full path to scan file (FileSelector)")
    field(DTYP, "pydev")
    field(OUT, "@graffiti_plot.set_selected_file('VAL')")
    field(SIZV, "255")
}

record(longout, "$(P)FileNumber") {
    field(DESC, "Scan #; auto-reload plot")
    field(DTYP, "pydev")
    field(OUT, "@graffiti_plot.set_file_number(VAL)")
}

record(longout, "$(P)SpecScanNumber") {
    field(DESC, "SPEC scan number (#S)")
    field(DTYP, "pydev")
    field(OUT, "@graffiti_plot.set_spec_scan_number(VAL)")
}

record(longin, "$(P)ScanNumber_RBV") {
    field(DTYP, "pydev")
    field(INP, "@graffiti_plot.scan_number_rbv()")
}
