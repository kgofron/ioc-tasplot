    <widget type="textentry" version="3.0.0">
      <name>DataFileText</name>
      <pv_name>$(P)DataFileText</pv_name>
      <x>5</x>
      <y>28</y>
      <width>955</width>
      <height>1130</height>
      <font>
        <font family="Monospace" style="REGULAR" size="11.0">
        </font>
