<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>TASPlot</name>
  <macros>
    <P>$(P=TAS:Plot:)</P>
  </macros>
  <width>1100</width>
  <height>1160</height>
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <text>ioc-tasplot — Browse + Graph (SPiCE Data tab successor)</text>
    <x>10</x>
    <y>8</y>
    <width>1080</width>
    <height>28</height>
    <font>
      <font family="Sans" style="BOLD" size="16.0">
      </font>
    </font>
  </widget>
  <widget type="group" version="3.0.0">
    <name>BrowseData</name>
    <x>10</x>
    <y>40</y>
    <width>1080</width>
    <height>140</height>
    <widget type="label" version="2.0.0">
      <name>BrowseHdr</name>
      <text>Browse Data (file selection)</text>
      <x>5</x>
      <y>5</y>
      <width>200</width>
      <height>22</height>
      <font>
        <font family="Sans" style="BOLD" size="12.0">
        </font>
      </font>
    </widget>
    <widget type="label" version="2.0.0">
      <name>FileLbl</name>
      <text>File</text>
      <x>5</x>
      <y>32</y>
      <width>35</width>
      <height>25</height>
      <horizontal_alignment>2</horizontal_alignment>
    </widget>
    <widget type="textentry" version="3.0.0">
      <name>SelectedFile</name>
      <pv_name>$(P)SelectedFile.$</pv_name>
      <x>50</x>
      <y>30</y>
      <width>960</width>
      <height>28</height>
      <format>6</format>
      <tooltip>Paste or type path (writes SelectedFile); folder button also writes here. Grey header shows resolved path after Scan #.</tooltip>
    </widget>
    <widget type="fileselector" version="2.0.0">
      <name>FileSelector</name>
      <pv_name>$(P)SelectedFile.$</pv_name>
      <x>1010</x>
      <y>30</y>
      <width>30</width>
      <height>30</height>
      <tooltip>Browse for scan file (writes SelectedFile)</tooltip>
    </widget>
    <widget type="label" version="2.0.0">
      <name>FileNumLbl</name>
      <text>Scan #</text>
      <x>5</x>
      <y>70</y>
      <width>50</width>
      <height>25</height>
      <horizontal_alignment>2</horizontal_alignment>
    </widget>
    <widget type="spinner" version="2.0.0">
      <name>FileNumber</name>
      <pv_name>$(P)FileNumber</pv_name>
      <x>65</x>
      <y>68</y>
      <width>75</width>
      <height>28</height>
      <precision>0</precision>
      <tooltip>Scan # (SPiCE scroll) — step arrows browse *_scanNNNN.dat in same directory</tooltip>
      <minimum>1.0</minimum>
      <maximum>9999.0</maximum>
    </widget>
    <widget type="label" version="2.0.0">
      <name>SpecScanLbl</name>
      <text>SPEC #S</text>
      <x>148</x>
      <y>70</y>
      <width>60</width>
      <height>25</height>
      <horizontal_alignment>2</horizontal_alignment>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>ReloadBtn</name>
      <actions>
        <action type="write_pv">
          <description>Reload scan</description>
          <pv_name>$(P)Acquire</pv_name>
          <value>1</value>
        </action>
      </actions>
      <text>Reload</text>
      <x>300</x>
      <y>61</y>
      <width>90</width>
      <height>35</height>
      <tooltip>Re-read current file (browse and Scan # reload automatically)</tooltip>
    </widget>
    <widget type="label" version="2.0.0">
      <name>ExistsLbl</name>
      <text>File OK</text>
      <x>400</x>
      <y>70</y>
      <width>55</width>
      <height>25</height>
      <horizontal_alignment>2</horizontal_alignment>
    </widget>
    <widget type="led" version="2.0.0">
      <name>FileExists</name>
      <pv_name>$(P)FileExists_RBV</pv_name>
      <x>460</x>
      <y>65</y>
      <width>30</width>
      <height>30</height>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>FullFileName</name>
      <pv_name>$(P)FullFileName_RBV.$</pv_name>
      <x>213</x>
      <y>3</y>
      <width>830</width>
      <height>24</height>
      <foreground_color>
        <color red="100" green="100" blue="100">
        </color>
      </foreground_color>
      <format>6</format>
      <tooltip>Resolved path IOC loads (matches File after Scan # change)</tooltip>
    </widget>
    <widget type="spinner" version="2.0.0">
      <name>SpecScanNumber</name>
      <pv_name>$(P)SpecScanNumber</pv_name>
      <x>210</x>
      <y>68</y>
      <width>75</width>
      <height>28</height>
      <precision>0</precision>
      <tooltip>Scan # (SPiCE scroll) — step arrows browse *_scanNNNN.dat in same directory</tooltip>
      <minimum>1.0</minimum>
      <maximum>9999.0</maximum>
    </widget>
  </widget>
  <widget type="group" version="3.0.0">
    <name>GraphData</name>
    <x>10</x>
    <y>180</y>
    <width>1080</width>
    <height>560</height>
    <scripts>
      <script file="EmbeddedPy">
        <text><![CDATA[from org.csstudio.display.builder.runtime.script import PVUtil, ScriptUtil

headers = PVUtil.getString(pvs[0])
items = [h.strip() for h in headers.split(';') if h.strip()]
if not items:
    items = [' ']

for wname in ('XCol', 'YCol', 'NormCol'):
    w = ScriptUtil.findWidgetByName(widget, wname)
    if w is not None:
        w.setItems(items)

xact = PVUtil.getString(pvs[1])
if xact in items:
    pvs[2].write(xact)
yact = PVUtil.getString(pvs[3])
if yact in items:
    pvs[4].write(yact)]]></text>
        <pv_name>$(P)ColHeaders_RBV.$</pv_name>
        <pv_name>$(P)XCol_RBV</pv_name>
        <pv_name trigger="false">$(P)XCol</pv_name>
        <pv_name>$(P)YCol_RBV</pv_name>
        <pv_name trigger="false">$(P)YCol</pv_name>
      </script>
    </scripts>
    <widget type="label" version="2.0.0">
      <name>GraphHdr</name>
      <text>Graph Data</text>
      <x>970</x>
      <y>5</y>
      <width>80</width>
      <height>22</height>
      <font>
        <font family="Sans" style="BOLD" size="12.0">
        </font>
      </font>
    </widget>
    <widget type="label" version="2.0.0">
      <name>XColLbl</name>
      <text>X col</text>
      <x>5</x>
      <y>5</y>
      <width>40</width>
      <height>22</height>
      <horizontal_alignment>2</horizontal_alignment>
    </widget>
    <widget type="combo" version="2.0.0">
      <name>XCol</name>
      <pv_name>$(P)XCol</pv_name>
      <x>55</x>
      <y>3</y>
      <height>24</height>
      <tooltip>X column (list from ColHeaders_RBV)</tooltip>
      <items>
        <item>s1</item>
        <item>detector</item>
        <item>time</item>
      </items>
      <items_from_pv>false</items_from_pv>
    </widget>
    <widget type="label" version="2.0.0">
      <name>YColLbl</name>
      <text>Y col</text>
      <x>170</x>
      <y>5</y>
      <width>40</width>
      <height>22</height>
      <horizontal_alignment>2</horizontal_alignment>
    </widget>
    <widget type="combo" version="2.0.0">
      <name>YCol</name>
      <pv_name>$(P)YCol</pv_name>
      <x>215</x>
      <y>3</y>
      <height>24</height>
      <tooltip>Y column; Poisson errors on Y</tooltip>
      <items>
        <item>detector</item>
        <item>monitor</item>
        <item>mcu</item>
      </items>
      <items_from_pv>false</items_from_pv>
    </widget>
    <widget type="label" version="2.0.0">
      <name>NormLbl</name>
      <text>Norm</text>
      <x>330</x>
      <y>5</y>
      <width>38</width>
      <height>22</height>
      <horizontal_alignment>2</horizontal_alignment>
    </widget>
    <widget type="combo" version="2.0.0">
      <name>NormMode</name>
      <pv_name>$(P)NormMode</pv_name>
      <x>380</x>
      <y>3</y>
      <width>80</width>
      <height>24</height>
      <tooltip>SPiCE Normalize to: None, column, or fixed value</tooltip>
      <items>
        <item>None</item>
        <item>Column</item>
        <item>Fixed</item>
      </items>
      <items_from_pv>false</items_from_pv>
    </widget>
    <widget type="combo" version="2.0.0">
      <name>NormCol</name>
      <pv_name>$(P)NormCol</pv_name>
      <x>465</x>
      <y>3</y>
      <width>80</width>
      <height>24</height>
      <tooltip>Normalization column (monitor, mcu, time, …)</tooltip>
      <items>
        <item>monitor</item>
        <item>mcu</item>
        <item>time</item>
      </items>
      <items_from_pv>false</items_from_pv>
    </widget>
    <widget type="spinner" version="2.0.0">
      <name>NormValue</name>
      <pv_name>$(P)NormValue</pv_name>
      <x>550</x>
      <y>3</y>
      <width>75</width>
      <height>24</height>
      <tooltip>Fixed divisor when Norm mode is Fixed</tooltip>
      <minimum>1.0</minimum>
      <maximum>1000000.0</maximum>
    </widget>
    <widget type="label" version="2.0.0">
      <name>FormatLbl</name>
      <text>Format</text>
      <x>640</x>
      <y>5</y>
      <width>55</width>
      <height>22</height>
      <horizontal_alignment>2</horizontal_alignment>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>Format</name>
      <pv_name>$(P)Format_RBV</pv_name>
      <x>700</x>
      <y>3</y>
      <width>55</width>
      <height>24</height>
    </widget>
    <widget type="label" version="2.0.0">
      <name>RowsLbl</name>
      <text>Rows</text>
      <x>770</x>
      <y>5</y>
      <width>40</width>
      <height>22</height>
      <horizontal_alignment>2</horizontal_alignment>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>NRows</name>
      <pv_name>$(P)NRows_RBV</pv_name>
      <x>815</x>
      <y>3</y>
      <width>45</width>
      <height>24</height>
      <format>1</format>
    </widget>
    <widget type="label" version="2.0.0">
      <name>ColsLbl</name>
      <text>Cols</text>
      <x>870</x>
      <y>5</y>
      <width>40</width>
      <height>22</height>
      <horizontal_alignment>2</horizontal_alignment>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>NColumns</name>
      <pv_name>$(P)NColumns_RBV</pv_name>
      <x>915</x>
      <y>3</y>
      <width>45</width>
      <height>24</height>
      <format>1</format>
    </widget>
    <widget type="label" version="2.0.0">
      <name>ColHdrLbl</name>
      <text>Columns</text>
      <x>5</x>
      <y>35</y>
      <width>50</width>
      <height>22</height>
      <horizontal_alignment>2</horizontal_alignment>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>ColHeaders</name>
      <pv_name>$(P)ColHeaders_RBV.$</pv_name>
      <x>65</x>
      <y>33</y>
      <width>980</width>
      <height>22</height>
      <foreground_color>
        <color red="80" green="80" blue="80">
        </color>
      </foreground_color>
      <format>6</format>
    </widget>
    <widget type="label" version="2.0.0">
      <name>ErrLbl</name>
      <text>Last error</text>
      <x>8</x>
      <y>60</y>
      <width>60</width>
      <height>22</height>
      <horizontal_alignment>2</horizontal_alignment>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>LastError</name>
      <pv_name>$(P)LastError_RBV</pv_name>
      <x>80</x>
      <y>58</y>
      <width>965</width>
      <height>24</height>
      <foreground_color>
        <color red="180" green="0" blue="0">
        </color>
      </foreground_color>
    </widget>
    <widget type="xyplot" version="3.0.0">
      <name>ScanPlot</name>
      <x>5</x>
      <y>90</y>
      <width>1040</width>
      <height>430</height>
      <rules>
        <rule name="XlabelAx" prop_id="x_axis.title" out_exp="true">
          <exp bool_exp="True">
            <expression>pvStr0</expression>
          </exp>
          <pv_name>$(P)XCol_RBV</pv_name>
        </rule>
        <rule name="YlabelAx" prop_id="y_axes[0].title" out_exp="true">
          <exp bool_exp="True">
            <expression>pvStr0</expression>
          </exp>
          <pv_name>$(P)PlotAxisLabel_RBV</pv_name>
        </rule>
        <rule name="PlotTitle" prop_id="title" out_exp="true">
          <exp bool_exp="True">
            <expression>pvStr0</expression>
          </exp>
          <pv_name>$(P)Command_RBV.$</pv_name>
        </rule>
      </rules>
      <x_axis>
        <title>X</title>
        <autoscale>true</autoscale>
        <log_scale>false</log_scale>
        <minimum>0.0</minimum>
        <maximum>1.0</maximum>
        <show_grid>true</show_grid>
        <title_font>
          <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
          </font>
        </title_font>
        <scale_font>
          <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
          </font>
        </scale_font>
        <visible>true</visible>
      </x_axis>
      <y_axes>
        <y_axis>
          <title>Y</title>
          <autoscale>true</autoscale>
          <log_scale>false</log_scale>
          <minimum>0.0</minimum>
          <maximum>1.0</maximum>
          <show_grid>true</show_grid>
          <title_font>
            <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
            </font>
          </title_font>
          <scale_font>
            <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
            </font>
          </scale_font>
          <on_right>false</on_right>
          <visible>true</visible>
          <color>
            <color red="0" green="0" blue="200">
            </color>
          </color>
        </y_axis>
      </y_axes>
      <traces>
        <trace>
          <name>scan</name>
          <x_pv>$(P)Xdata</x_pv>
          <y_pv>$(P)Ydata</y_pv>
          <err_pv>$(P)YdataErr</err_pv>
          <axis>0</axis>
          <trace_type>1</trace_type>
          <color>
            <color red="0" green="80" blue="200">
            </color>
          </color>
          <line_width>1</line_width>
          <line_style>0</line_style>
          <point_type>2</point_type>
          <point_size>6</point_size>
          <visible>true</visible>
        </trace>
      </traces>
    </widget>
  </widget>
  <widget type="group" version="3.0.0">
    <name>DataFileContents</name>
    <x>10</x>
    <y>740</y>
    <width>1080</width>
    <height>410</height>
    <widget type="label" version="2.0.0">
      <name>DataFileHdr</name>
      <text>DataFileContents</text>
      <x>5</x>
      <y>5</y>
      <width>160</width>
      <height>22</height>
      <font>
        <font family="Sans" style="BOLD" size="11.0">
        </font>
      </font>
    </widget>
    <widget type="textentry" version="3.0.0">
      <name>DataFileText</name>
      <pv_name>$(P)DataFileText</pv_name>
      <x>5</x>
      <y>5</y>
      <width>1040</width>
      <height>360</height>
      <font>
        <font family="Monospace" style="REGULAR" size="11.0">
        </font>
      </font>
      <foreground_color>
        <color red="40" green="40" blue="40">
        </color>
      </foreground_color>
      <background_color>
        <color red="240" green="240" blue="240">
        </color>
      </background_color>
      <format>6</format>
      <vertical_alignment>0</vertical_alignment>
      <wrap_words>true</wrap_words>
      <multi_line>true</multi_line>
      <tooltip>SPiCE DataFileContents — CHAR waveform (pcaspy SpecFile pattern)</tooltip>
    </widget>
  </widget>
</display>
