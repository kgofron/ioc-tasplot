  <widget type="group" version="3.0.0">
    <name>GraphData</name>
    <x>5</x>
    <y>180</y>
    <width>1100</width>
    <height>560</height>
    <scripts>
      <script file="EmbeddedPy">
        <text><![CDATA[from org.csstudio.display.builder.runtime.script import PVUtil, ScriptUtil

headers = PVUtil.getString(pvs[0])
items = [h.strip() for h in headers.split(';') if h.strip()]
if not items:
    items = [' ']

for wname in ('XCol', 'YCol', 'NormCol'):
    w = ScriptUtil.findWidgetByName(widget, wname)
    if w is not None:
        w.setItems(items)

xact = PVUtil.getString(pvs[1])
if xact in items:
    pvs[2].write(xact)
yact = PVUtil.getString(pvs[3])
if yact in items:
    pvs[4].write(yact)]]></text>
        <pv_name>$(P)ColHeaders_RBV.$</pv_name>
        <pv_name>$(P)XCol_RBV</pv_name>
        <pv_name trigger="false">$(P)XCol</pv_name>
        <pv_name>$(P)YCol_RBV</pv_name>
        <pv_name trigger="false">$(P)YCol</pv_name>
      </script>
    </scripts>
    <widget type="label" version="2.0.0">
