    <widget type="xyplot" version="3.0.0">
      <name>ScanPlot</name>
      <x>5</x>
      <y>90</y>
      <width>1050</width>
      <height>430</height>
      <rules>
        <rule name="XlabelAx" prop_id="x_axis.title" out_exp="true">
          <exp bool_exp="True">
            <expression>pvStr0</expression>
          </exp>
          <pv_name>$(P)XCol_RBV</pv_name>
        </rule>
        <rule name="YlabelAx" prop_id="y_axes[0].title" out_exp="true">
          <exp bool_exp="True">
            <expression>pvStr0</expression>
          </exp>
          <pv_name>$(P)PlotAxisLabel_RBV</pv_name>
        </rule>
        <rule name="PlotTitle" prop_id="title" out_exp="true">
          <exp bool_exp="True">
            <expression>pvStr0</expression>
          </exp>
          <pv_name>$(P)Command_RBV.$</pv_name>
        </rule>
        <rule name="XLogOn" prop_id="x_axis.log_scale" out_exp="false">
          <exp bool_exp="pv0&gt;0">
            <value>true</value>
          </exp>
          <exp bool_exp="pv0&lt;=0">
            <value>false</value>
          </exp>
          <pv_name>loc://$(DID)_logX(0)</pv_name>
        </rule>
        <rule name="YLogOn" prop_id="y_axes[0].log_scale" out_exp="false">
          <exp bool_exp="pv0&gt;0">
            <value>true</value>
          </exp>
          <exp bool_exp="pv0&lt;=0">
            <value>false</value>
          </exp>
          <pv_name>loc://$(DID)_logY(0)</pv_name>
        </rule>
      </rules>
      <x_axis>
        <title>X</title>
        <autoscale>true</autoscale>
        <log_scale>false</log_scale>
        <minimum>0.0</minimum>
        <maximum>1.0</maximum>
        <show_grid>true</show_grid>
        <title_font>
          <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
          </font>
        </title_font>
        <scale_font>
          <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
          </font>
        </scale_font>
        <visible>true</visible>
      </x_axis>
      <y_axes>
        <y_axis>
          <title>Y</title>
          <autoscale>true</autoscale>
          <log_scale>false</log_scale>
          <minimum>0.0</minimum>
          <maximum>1.0</maximum>
          <show_grid>true</show_grid>
          <title_font>
            <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
            </font>
          </title_font>
          <scale_font>
            <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
            </font>
          </scale_font>
          <on_right>false</on_right>
          <visible>true</visible>
          <color>
            <color red="0" green="0" blue="200">
            </color>
          </color>
        </y_axis>
      </y_axes>
      <traces>
        <trace>
          <name>scan</name>
          <x_pv>$(P)Xdata</x_pv>
          <y_pv>$(P)Ydata</y_pv>
          <err_pv>$(P)YdataErr</err_pv>
          <axis>0</axis>
          <trace_type>1</trace_type>
          <color>
            <color red="0" green="80" blue="200">
            </color>
          </color>
          <line_width>1</line_width>
          <line_style>0</line_style>
          <point_type>2</point_type>
          <point_size>6</point_size>
          <visible>true</visible>
        </trace>
        <trace>
          <name>overlay</name>
          <x_pv>$(P)OverlayXdata</x_pv>
          <y_pv>$(P)OverlayYdata</y_pv>
          <err_pv>$(P)OverlayYdataErr</err_pv>
          <axis>0</axis>
          <trace_type>1</trace_type>
          <color>
            <color red="200" green="80" blue="0">
            </color>
          </color>
          <line_width>1</line_width>
          <line_style>0</line_style>
          <point_type>2</point_type>
          <point_size>5</point_size>
          <visible>true</visible>
        </trace>
        <trace>
          <name>combine</name>
          <x_pv>$(P)CombineXdata</x_pv>
          <y_pv>$(P)CombineYdata</y_pv>
          <err_pv>$(P)CombineYdataErr</err_pv>
          <axis>0</axis>
          <trace_type>1</trace_type>
          <color>
            <color red="0" green="140" blue="60">
            </color>
          </color>
          <line_width>2</line_width>
          <line_style>0</line_style>
          <point_type>2</point_type>
          <point_size>5</point_size>
          <visible>true</visible>
        </trace>
        <trace>
          <name>buffer</name>
          <x_pv>$(P)BufferXdata</x_pv>
          <y_pv>$(P)BufferYdata</y_pv>
          <err_pv>$(P)BufferYdataErr</err_pv>
          <axis>0</axis>
          <trace_type>1</trace_type>
          <color>
            <color red="140" green="40" blue="160">
            </color>
          </color>
          <line_width>2</line_width>
          <line_style>0</line_style>
          <point_type>2</point_type>
          <point_size>5</point_size>
          <visible>true</visible>
        </trace>
        <trace>
          <name>bufferB</name>
          <x_pv>$(P)BufferBXdata</x_pv>
          <y_pv>$(P)BufferBYdata</y_pv>
          <err_pv>$(P)BufferBYdataErr</err_pv>
          <axis>0</axis>
          <trace_type>1</trace_type>
          <color>
            <color red="180" green="60" blue="120">
            </color>
          </color>
          <line_width>2</line_width>
          <line_style>0</line_style>
          <point_type>2</point_type>
          <point_size>5</point_size>
          <visible>true</visible>
        </trace>
        <trace>
          <name>fit</name>
          <x_pv>$(P)FitXdata</x_pv>
          <y_pv>$(P)FitYdata</y_pv>
          <err_pv></err_pv>
          <axis>0</axis>
          <trace_type>1</trace_type>
          <color>
            <color red="200" green="40" blue="40">
            </color>
          </color>
          <line_width>2</line_width>
          <line_style>0</line_style>
          <point_type>0</point_type>
          <point_size>1</point_size>
          <visible>true</visible>
        </trace>
      </traces>
    </widget>
  </widget>
  <widget type="group" version="3.0.0">
    <name>DataFileContents</name>
